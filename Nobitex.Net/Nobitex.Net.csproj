<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Nobitex.Net</RootNamespace>
    <AssemblyName>Nobitex.Net</AssemblyName>
    <!-- NuGet package metadata -->
    <PackageId>Nobitex.Net</PackageId>
    <Version>2.0.0</Version>
    <Authors>Nobitex.Net Contributors</Authors>
    <Company>Nobitex.Net</Company>
    <Product>Nobitex.Net</Product>
    <Description>
      A complete, modern and fully documented C# client library for the Nobitex cryptocurrency
      exchange REST API and WebSocket (Centrifugo) streams. Supports trading, order management,
      wallets, deposits/withdrawals and realtime market data.
    </Description>
    <PackageTags>nobitex;crypto;exchange;trading;bot;api;websocket;fintech;iran;bitcoin</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/your-user/Nobitex.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/your-user/Nobitex.Net</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ProjectGuid>{7191BBFB-1F66-40E7-BEFE-1056A83713FA}</ProjectGuid>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ed25519 request signing (Nobitex-Key / Nobitex-Signature / Nobitex-Timestamp) -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <!-- Optional structured logging support -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>
</Project>